<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- GroupBox Border -->
    <Style TargetType="Border" x:Key="GroupBoxBorder">
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Margin" Value="5"/>
    </Style>

    <!-- Interactive Button -->
    <Style TargetType="Button" x:Key="InteractiveButton">
        <Setter Property="Shadow">
            <Shadow Brush="Black" Radius="8" Opacity="0.3" Offset="2,2"/>
        </Setter>

        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup Name="CommonStates">

                    <!-- Normal -->
                    <VisualState Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                        </VisualState.Setters>
                    </VisualState>

                    <!-- Survol (desktop) -->
                    <VisualState Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDarkText}}"/>
                        </VisualState.Setters>
                    </VisualState>

                    <!-- Pressed -->
                    <VisualState Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource Gray600}}"/>
                        </VisualState.Setters>
                    </VisualState>

                    <!-- Disabled -->
                    <VisualState Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}"/>
                            <Setter Property="TextColor" Value="{StaticResource White}"/>
                            <Setter Property="Shadow">
                                <Shadow Brush="Transparent"/>
                            </Setter>
                        </VisualState.Setters>
                    </VisualState>

                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

</ResourceDictionary>
