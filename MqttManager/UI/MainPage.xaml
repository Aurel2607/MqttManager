<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MqttManager.MainPage"
             Title="MQTT Manager">

    <!-- Border Ressources -->
    <ContentPage.Resources>
        <Style TargetType="Border" x:Key="GroupBoxBorder">
            <Setter Property="Stroke" Value="Gray"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 8"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="1"/>
        </Style>
    </ContentPage.Resources>

    
    <ScrollView>
        <Grid ColumnSpacing="20" RowSpacing="10" Padding="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /> <!-- intercepted messages -->
                <RowDefinition Height="Auto" /> <!-- broker events -->
            </Grid.RowDefinitions>

            <!-- Section Serveur -->
            <!-- Broker column -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource GroupBoxBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="MQTT Broker" FontSize="20" FontAttributes="Bold"/>
                    <Entry Text="{Binding BrokerPort}" Placeholder="Port"/>
                    <Label Text="{Binding BrokerStatus}" FontAttributes="Italic"/>
                    <Button Text="Start Broker" Command="{Binding StartBrokerCommand}" HorizontalOptions="Fill"/>
                    <Button Text="Stop Broker" Command="{Binding StopBrokerCommand}" HorizontalOptions="Fill"/>
                </VerticalStackLayout>
            </Border>
            
            <!-- Client column -->
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource GroupBoxBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="MQTT Client" FontSize="20" FontAttributes="Bold"/>
                    <Entry Placeholder="Topic"/>
                    <Entry Placeholder="Payload"/>
                    <Button Text="Connect" HorizontalOptions="Fill"/>
                    <Button Text="Publish" HorizontalOptions="Fill"/>
                </VerticalStackLayout>
            </Border>

            <!-- Intercepted messages (row 1, spanning 2 columns) -->
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource GroupBoxBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Broker Intercepted Messages" FontSize="20" FontAttributes="Bold"/>
                    <CollectionView ItemsSource="{Binding BrokerMessages}" HeightRequest="200" VerticalOptions="FillAndExpand">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding}" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Button Text="Clear Messages" Command="{Binding ClearBrokerMessagesCommand}" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource GroupBoxBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Broker Events" FontSize="20" FontAttributes="Bold"/>
                    <CollectionView ItemsSource="{Binding BrokerEvents}" HeightRequest="200" VerticalOptions="FillAndExpand">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding}" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Button Text="Clear Events" Command="{Binding ClearBrokerEventsCommand}" />
                </VerticalStackLayout>
            </Border>

        </Grid>
    </ScrollView>
</ContentPage>
